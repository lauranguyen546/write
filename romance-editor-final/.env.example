# Romance Editor Configuration

# LLM Provider Configuration
# Choose either "openai" or "anthropic"
LLM_PROVIDER=anthropic

# API Keys
# You need at least ONE of these, depending on which provider you choose

# Anthropic API Key (for Claude models)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API Key (for GPT models)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Model Configuration (Optional)
# These have sensible defaults, only uncomment if you want to change them

# Anthropic model (default: claude-sonnet-4-20250514)
# Other options: claude-opus-4-5-20251101, claude-3-5-sonnet-20241022
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI model (default: gpt-4-turbo-preview)
# Other options: gpt-4, gpt-4-turbo, gpt-3.5-turbo
# OPENAI_MODEL=gpt-4-turbo-preview
