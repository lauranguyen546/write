// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Project {
  id           String       @id @default(uuid())
  title        String
  settingsJson String       // JSON: subgenre, heatLevel, tropes, povStyle, targetTone
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  manuscripts  Manuscript[]
  issues       Issue[]
  jobs         Job[]
  notes        Note[]
  writingRules WritingRule[]
  versions     ManuscriptVersion[]
  shares       SharedManuscript[]
}

model Manuscript {
  id           String   @id @default(uuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  originalText String   // Full text
  createdAt    DateTime @default(now())
  chunks       Chunk[]
}

model Chunk {
  id           String     @id @default(uuid())
  manuscriptId String
  manuscript   Manuscript @relation(fields: [manuscriptId], references: [id], onDelete: Cascade)
  index        Int        // Order in manuscript
  text         String     // Chunk text
  chapter      String?    // Chapter title/number if detected
  scene        String?    // Scene identifier
  startChar    Int        // Start position in original text
  endChar      Int        // End position in original text
  summaryJson  String?    // JSON: key events, characters, setting
  issues       Issue[]
}

model Issue {
  id          String     @id @default(uuid())
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chunkId     String?
  chunk       Chunk?     @relation(fields: [chunkId], references: [id], onDelete: SetNull)
  category    String     // developmental, character, scene, line, repetition
  severity    String     // critical, major, minor, suggestion
  title       String
  description String
  evidence    String?    // Quoted text showing the issue
  suggestion  String?    // How to fix it
  startChar   Int?       // Position in chunk
  endChar     Int?       // Position in chunk
  tagsJson    String?    // JSON: additional tags (character names, etc.)
  status      String     @default("todo") // todo, in_progress, resolved, dismissed
  priority    Int        @default(2)      // 1-3 stars
  editingPass String?    // first_draft, line_edit, polish
  createdAt   DateTime   @default(now())
  revisions   Revision[]

  @@index([projectId, status])
}

model Revision {
  id            String   @id @default(uuid())
  issueId       String
  issue         Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  originalText  String   // Text before revision
  suggestedText String   // AI-generated rewrite
  diffJson      String?  // JSON: diff data for display
  status        String   @default("proposed") // proposed, accepted, rejected
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Job {
  id           String   @id @default(uuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type         String   // analysis, rewrite_generation
  status       String   @default("pending") // pending, running, completed, failed
  progress     Int      @default(0) // 0-100
  resultJson   String?  // JSON: results or error info
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Note {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  type        String   // "character", "setting", "plot", "theme", "custom"
  title       String
  content     String   // Markdown-formatted
  tags        String   @default("[]") // JSON array of tags for filtering/searching

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId, type])
}

model ManuscriptVersion {
  id            String   @id @default(uuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versionNumber Int
  content       String   // composed text (original + accepted revisions at snapshot time)
  contentHash   String   // sha256 for dedup — skip snapshot if unchanged
  wordCount     Int
  description   String?
  createdBy     String   @default("user") // "user" | "auto-accept"
  createdAt     DateTime @default(now())

  @@index([projectId, versionNumber])
}

model SharedManuscript {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  token     String   @unique @default(uuid()) // unguessable public URL slug
  active    Boolean  @default(true)
  viewCount Int      @default(0)

  createdAt DateTime @default(now())
  comments  BetaComment[]

  @@index([projectId])
}

model BetaComment {
  id        String           @id @default(uuid())
  shareId   String
  share     SharedManuscript @relation(fields: [shareId], references: [id], onDelete: Cascade)

  readerName String
  text       String  // The comment itself
  excerpt    String? // The passage the reader selected
  position   Int?    // Character offset of the excerpt in the shared text
  type       String  @default("comment") // "praise", "confusion", "suggestion", "typo", "comment"

  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([shareId, position])
}

model WritingRule {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  category    String   // "style", "voice", "grammar", "forbidden"
  rule        String   // Human-readable rule description
  examples    String   @default("[]") // JSON array of example sentences
  priority    Int      @default(50) // 0-100, higher = more important
  enabled     Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId, category])
  @@index([projectId, enabled])
}
